# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/loveconstructor

# JWT Secret — сгенерируйте надёжный ключ: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-me

# Server
PORT=3000
NODE_ENV=development

# VK OAuth (get at https://dev.vk.com)
# Важно: в настройках VK-приложения добавьте redirect URI: https://loveconstructor.ru/api/auth/vk/callback
VK_APP_ID=
VK_APP_SECRET=
VK_CALLBACK_URL=http://localhost:3000/api/auth/vk/callback

# Site URL (for redirects and CORS)
SITE_URL=http://localhost:3000
